# Copy to .env (or export) — every value is optional for the prototype.

# Real SMS through Africa's Talking. Leave empty to use the built-in SMS simulator.
# Use AT_USERNAME=sandbox with a sandbox API key to test without sending real messages.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Password for the seeded demo team accounts (default: qinga-demo).
DEMO_PASSWORD=

# Where the SQLite database and uploads live (default: ./data).
QINGA_DATA_DIR=

# Who the Red Cross brief is addressed to (display only in the prototype).
REDCROSS_BRIEF_TO=

# Set to 1 to stop the hourly Open-Meteo forecast job (e.g. offline demos).
QINGA_DISABLE_FORECASTS=

# Production only: max upload size for photos/videos (npm start sets 26M).
BODY_SIZE_LIMIT=26M
